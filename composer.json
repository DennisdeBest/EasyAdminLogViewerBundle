{
	"name": "codebuds/easyadmin-log-viewer-bundle",
	"type": "symfony-bundle",
	"description": "A Symfony bundle that provides a log viewer interface for EasyAdmin backends",
	"keywords": ["symfony", "easyadmin", "bundle", "log", "viewer"],
	"homepage": "https://github.com/DennisdeBest/EasyAdminLogViewerBundle",
	"license": "MIT",
	"authors": [
		{
			"name": "Dennis de Best",
			"email": "dennis@debest.fr"
		}
	],
	"require": {
		"php": "^8.5",
		"easycorp/easyadmin-bundle": "^5.0",
		"symfony/framework-bundle": "^8.0",
		"symfony/twig-bundle": "^8.0",
		"symfony/ux-live-component": "^2.13|^3.0",
		"symfony/ux-twig-component": "^2.13|^3.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^11.0",
		"rector/rector": "^2.0",
		"roave/security-advisories": "dev-latest",
		"symfony/browser-kit": "^8.0",
		"symfony/phpunit-bridge": "^8.0",
		"symfony/routing": "^8.0",
		"symfony/yaml": "^8.0"
	},
	"autoload": {
		"psr-4": {
			"CodeBuds\\EasyAdminLogViewerBundle\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CodeBuds\\EasyAdminLogViewerBundle\\Tests\\": "tests/"
		}
	},
	"extra": {
		"symfony": {
			"bundle": "CodeBuds\\EasyAdminLogViewerBundle\\EasyAdminLogViewerBundle"
		},
		"branch-alias": {
			"dev-master": "1.0-dev"
		}
	},
	"config": {
		"sort-packages": true
	},

	"scripts": {
		"docker-build" : [
			"docker build -f docker/Dockerfile . --tag easy-admin-log-viewer-bundle"
		],
		"docker-run" : [
			"docker build --quiet -f docker/Dockerfile . --tag easy-admin-log-viewer-bundle && docker run -it --rm -v $(pwd):/app easy-admin-log-viewer-bundle run "
		],
		"cs-fix": [
			"@docker-run cs-fix"
		],
		"stan": [
			"@docker-run stan"
		],
		"rector": [
			"@docker-run rector"
		],
		"clean": [
			"@docker-run clean"
		],
		"test": [
			"@docker-run test"
		],
		"coverage": [
			"@docker-run coverage"
		]
	},

	"minimum-stability": "dev",
	"prefer-stable": true
}

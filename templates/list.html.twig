{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title 'Log files' %}
{% block content_title 'Log files' %}
{% block main %}
	{% if files is empty %}
		<div class="content-panel">
			<div class="p-4 text-center text-body-secondary">
				No log files were found in the configured logs directory.
			</div>
		</div>
	{% else %}
		<div class="content-panel">
			<table class="table datagrid">
				<thead>
				<tr>
					<th class="header-for-field-text">Name</th>
					<th class="header-for-field-text">Size</th>
					<th class="header-for-field-text">Path</th>
					<th class="header-for-field-text">Updated</th>
					<th class="text-end">Actions</th>
				</tr>
				</thead>
				<tbody>
				{% for file in files %}
					<tr>
						<td>
							<a href="{{ ea_url().setRoute('easy_admin_log_viewer_show', {path: file.path}) }}">{{ file.name }}</a>
						</td>
						<td>{{ file.humanSize }}</td>
						<td><code>{{ file.path }}</code></td>
						<td>{{ file.lastUpdatedAt|format_datetime() }}</td>
						<td class="text-end">
							<div class="d-inline-flex gap-2 align-items-center">
								<a class="btn btn-sm btn-secondary"
								   href="{{ ea_url().setRoute('easy_admin_log_viewer_show', {path: file.path}) }}">Show</a>
								<a class="btn btn-sm btn-outline-secondary"
								   href="{{ ea_url().setRoute('easy_admin_log_viewer_download', {path: file.path}) }}">Download</a>

								<form method="post"
											action="{{ path('easy_admin_log_viewer_delete') }}"
											class="d-inline"
											onsubmit="return confirm('Delete {{ file.name }}?')">
									<input type="hidden" name="_token" value="{{ csrf_token('delete-log-file') }}">
									<input type="hidden" name="path" value="{{ file.path }}">
									<button type="submit" class="btn btn-sm btn-danger">Delete</button>
								</form>
							</div>
						</td>
					</tr>
				{% endfor %}
				</tbody>
			</table>
		</div>
	{% endif %}
{% endblock %}

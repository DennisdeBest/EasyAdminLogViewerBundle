{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title 'Log files' %}
{% block page_content %}
	<table class="table datagrid {% if files is empty %}datagrid-empty{% endif %}">
		<thead>
		<tr>
			<th class="header-for-field-text">Name</th>
			<th class="header-for-field-text">Size</th>
			<th class="header-for-field-text">Path</th>
			<th class="header-for-field-text">Updated</th>
			<th></th>
		</tr>
		</thead>
		<tbody>
		{% for file in files %}
			<tr>
				<td><a href="{{ ea_url().setRoute('easy_admin_log_viewer_download', {path: file.path}) }}">{{ file.name }}</a></td>
				<td>{{ file.humanSize }}</td>
				<td>{{ file.path }}</td>
				<td>{{ file.lastUpdatedAt|format_datetime() }}</td>
				<td class="actions">
					<a class="action"
						 href="{{ ea_url().setRoute('easy_admin_log_viewer_show', {path: file.path}) }}"><span class="action-label">Show</span></a>

					<form method="post" action="{{ path('easy_admin_log_viewer_delete') }}" style="display: inline"
								onsubmit="return confirm('Delete {{ file.name }}?')">
						<input type="hidden" name="_token" value="{{ csrf_token('delete-log-file') }}">
						<input type="hidden" name="path" value="{{ file.path }}">
						<button type="submit" class="action text-danger" style="background: none; border: none; cursor: pointer; padding: 0">
							<span class="action-label">Delete</span>
						</button>
					</form>
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
{% endblock %}

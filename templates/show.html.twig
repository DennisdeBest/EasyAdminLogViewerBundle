{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}
	{{ file.name }} <small> size: {{ file.humanSize }} &mdash; last updated: {{ file.lastUpdatedAt|format_datetime }}</small>
{% endblock %}
{% block content_title %}
	{{ file.name }}
{% endblock %}
{% block page_actions %}
	<a class="btn btn-secondary" href="{{ ea_url().setRoute('easy_admin_log_viewer_list') }}">Return to list</a>
	<a class="btn btn-outline-secondary" href="{{ ea_url().setRoute('easy_admin_log_viewer_download', {path: file.path}) }}">Download</a>
	<form method="post" action="{{ path('easy_admin_log_viewer_delete') }}" class="d-inline"
				onsubmit="return confirm('Delete {{ file.name }}?')">
		<input type="hidden" name="_token" value="{{ csrf_token('delete-log-file') }}">
		<input type="hidden" name="path" value="{{ file.path }}">
		<button type="submit" class="btn btn-danger">Delete</button>
	</form>
	<a class="btn btn-outline-secondary" href="{{ ea_url().setRoute('easy_admin_log_viewer_show', {path: file.path}) }}">Reload</a>
{% endblock %}
{% block main %}
	<div class="content-panel">
		<div class="p-3 d-flex gap-4 flex-wrap text-body-secondary">
			<div><strong>Size:</strong> {{ file.humanSize }}</div>
			<div><strong>Updated:</strong> {{ file.lastUpdatedAt|format_datetime }}</div>
			<div><strong>Path:</strong> <code>{{ file.path }}</code></div>
		</div>
	</div>
	<div class="content-panel mt-3">
		<div class="p-3">
			<twig:EasyAdminLogViewer:Show :file="file" />
		</div>
	</div>
{% endblock %}
